{
  "name": "upi-expense-tracker",
  "version": "1.0.0",
  "description": "Offline-first Android expense tracker with UPI payment detection from bank SMS",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"modules/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"modules/**/*.js\" \"*.json\"",
    "check": "npm run lint && npm run format:check && npm test",
    "build:dev": "npx eas-cli@latest build --profile development --platform android",
    "build:app": "npx eas-cli@latest build --profile preview --platform android"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "3.9.10"
  }
}
