{
  "name": "upi-expense-tracker",
  "version": "1.0.0",
  "description": "Offline-first Android expense tracker with UPI payment detection from bank SMS",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --go --tunnel",
    "test": "node --no-warnings --test",
    "format": "prettier --write .",
    "check": "expo lint && prettier --check . && npm test",
    "build": "npx eas-cli@latest build --profile preview --platform android",
    "lint": "expo lint"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.25",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "3.9.10"
  }
}
